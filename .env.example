# OpenSky Network bucket credentials (Account -> Access Keys)
PRC_ACCESS_KEY=
PRC_SECRET_KEY=

# team identity from registration
PRC_TEAM_NAME=
PRC_TEAM_ID=

# buckets
PRC_S3_ENDPOINT=s3.opensky-network.org
PRC_DATA_BUCKET=competition-data
# per the 2026 rules each team submits to its own bucket
PRC_SUBMISSION_BUCKET=

